# Prescripto backend — PLACEHOLDERS ONLY. Never put real secrets here.
# Copy: cp backend/.env.example backend/.env  (then fill locally, never commit)

# Application
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/prescripto
POSTGRES_URL=postgresql://user:password@localhost:5432/prescripto

# Auth — coordinated rotation with chat/ (same values in both services, never rotate separately)
# Legacy var still read as CURRENT fallback so existing deploys keep working.
JWT_SECRET=change-me-legacy-fallback
JWT_SECRET_CURRENT=change-me-current
JWT_SECRET_PREVIOUS=change-me-previous-or-empty
JWT_ROTATION_DEADLINE=2026-09-19T00:00:00.000Z
JWT_EXPIRY=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# OAuth (README canonical; GOOGLE_CALLBACK_URL is code-only, required by google.strategy.ts)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# Cloudinary (README says CLOUDINARY_API_SECRET; code reads CLOUDINARY_SECRET_KEY — set BOTH to same value)
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_SECRET_KEY=your_api_secret

# Payments (STRIPE_WEBHOOK_SECRET + CURRENCY are code-only, required by appointments.service.ts)
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
CURRENCY=usd

# CORS allowlist (preferred). Falls back to FRONTEND_URL,ADMIN_URL when empty.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Code-only alias read by stripe success_url:
VITE_FRONTEND_URL=http://localhost:5173